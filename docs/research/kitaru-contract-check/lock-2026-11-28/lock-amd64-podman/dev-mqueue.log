# <probe>
import os
for p in ("/dev/shm/kcc-x", "/dev/mqueue/kcc-x"):
    try:
        os.close(os.open(p, os.O_WRONLY | os.O_CREAT, 0o644)); print(p, "ok")
    except OSError as e:
        print(p, e)
